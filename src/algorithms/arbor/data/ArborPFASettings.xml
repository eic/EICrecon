<!-- ArborPFASettings.xml
     Minimal Arbor algorithm settings for EIC detector reconstruction.
     ArborPFA uses tree-based clustering optimized for highly granular calorimeters.
     This configuration provides clustering and PFO formation via the Arbor algorithm.
-->
<pandora>

  <!-- Disable monitoring output in production -->
  <IsMonitoring>0</IsMonitoring>

  <!-- ======================================================================
       Input preparation
       ====================================================================== -->

  <!-- Initialize calorimeter hit preparation for tree-based clustering -->
  <algorithm type="CaloHitPreparation">
    <EnergyCorrection>1.0</EnergyCorrection>
    <CellLengthScale>10</CellLengthScale>
  </algorithm>

  <!-- ======================================================================
       Tree-based clusterization (Arbor algorithm)
       ====================================================================== -->

  <!-- Arbor algorithm: builds hierarchical trees from calorimeter hits -->
  <algorithm type="ClusteringParent">
    <!-- Main Arbor clustering algorithm -->
    <algorithm type="Arbor">
      <!-- Tree parameters -->
      <CellThresholdForRemoval>0.1</CellThresholdForRemoval>
      <MaxSearchLayer>100</MaxSearchLayer>
      <MaxTransverseCellLengthMultiplier>1.5</MaxTransverseCellLengthMultiplier>
      <MaxClusterEnergyToApplyCellThreshold>1.0</MaxClusterEnergyToApplyCellThreshold>
      <!-- Use shower profiles for clustering -->
      <UseShowerProfile>1</UseShowerProfile>
      <!-- Tree merging parameters -->
      <ShouldMergeIsolatedTrees>1</ShouldMergeIsolatedTrees>
      <IsolatedTreeEnergyCutForMerging>10.0</IsolatedTreeEnergyCutForMerging>
      <MinClusterEnergyForMerging>0.5</MinClusterEnergyForMerging>
    </algorithm>
  </algorithm>

  <!-- ======================================================================
       Track-cluster matching
       ====================================================================== -->

  <!-- Match tracks to tree-built clusters -->
  <algorithm type="TrackClusterAssociation">
    <TrackClusterAssociationMaxCaloHitSeparation>100</TrackClusterAssociationMaxCaloHitSeparation>
    <TrackClusterAssociationMaxSeparationFromTrack>50</TrackClusterAssociationMaxSeparationFromTrack>
  </algorithm>

  <!-- ======================================================================
       Particle flow object (PFO) formation
       ====================================================================== -->

  <!-- Create PFOs from Arbor-built clusters and tracks -->
  <algorithm type="ParticleFlowParent">
    <!-- Charged particles from tracks matched to clusters -->
    <algorithm type="ChargedPfoCreation">
      <UseNonAssociatedClusters>false</UseNonAssociatedClusters>
    </algorithm>

    <!-- Photons and neutral hadrons from unassociated clusters -->
    <algorithm type="NeutralPfoCreation">
      <MinClusterEnergy>0.1</MinClusterEnergy>
    </algorithm>
  </algorithm>

  <!-- ======================================================================
       Post-processing
       ====================================================================== -->

  <!-- PFO characterization and quality checks -->
  <algorithm type="PfoCharacterisation">
    <MipEquivalentEnergy>0.0004</MipEquivalentEnergy>
    <PfoEnergyCorrection>1.0</PfoEnergyCorrection>
  </algorithm>

</pandora>
